{
  "name": "trops-landing",
  "private": true,
  "scripts": {
    "build": "node scripts/build-static.js",
    "test": "node --test --test-concurrency=1 test/",
    "keys:verify": "node --env-file=.env.local scripts/verify-supabase-keys.js",
    "verify:deploy": "node scripts/verify-deployment.js",
    "verify:prod": "node scripts/verify-deployment.js https://www.trops.kr",
    "cleanup:preview": "node --env-file=.env.local scripts/cleanup-expired.js",
    "cleanup:apply": "node --env-file=.env.local scripts/cleanup-expired.js --apply",
    "refund:preview": "node --env-file=.env.local scripts/refund.js",
    "refund:apply": "node --env-file=.env.local scripts/refund.js --apply",
    "refund:blocked:preview": "node --env-file=.env.local scripts/refund-blocked.js",
    "refund:blocked:apply": "node --env-file=.env.local scripts/refund-blocked.js --apply",
    "refund:nda-outcome:preview": "node --env-file=.env.local scripts/refund-nda-outcome.js",
    "refund:nda-outcome:apply": "node --env-file=.env.local scripts/refund-nda-outcome.js --apply",
    "remind:preview": "node --env-file=.env.local scripts/payment-reminder.js",
    "remind:apply": "node --env-file=.env.local scripts/payment-reminder.js --apply",
    "deliver": "node --env-file=.env.local scripts/deliver.js",
    "erasure:find": "node --env-file=.env.local scripts/erasure.js --email",
    "erasure:preview": "node --env-file=.env.local scripts/erasure.js",
    "erasure:apply": "node --env-file=.env.local scripts/erasure.js --apply",
    "metrics:precheck": "node --env-file=.env.local scripts/precheck-metrics.js",
    "metrics:precheck:json": "node --env-file=.env.local scripts/precheck-metrics.js --json",
    "metrics:precheck:sql": "node scripts/precheck-metrics.js --sql"
  },
  "dependencies": {
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0"
  }
}
