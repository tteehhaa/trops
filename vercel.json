{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en-precheck",
      "destination": "https://app.trops.kr/export-precheck/new",
      "permanent": false
    },
    {
      "source": "/check",
      "destination": "/precheck",
      "permanent": false
    },
    {
      "source": "/en-check",
      "destination": "https://app.trops.kr/export-precheck/new",
      "permanent": false
    },
    {
      "source": "/nda",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/uae",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/en-nda",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/en-uae",
      "destination": "/en",
      "permanent": false
    }
  ]
}
